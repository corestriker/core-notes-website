---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  bild: ImageMetadata;
  alt: string;
  text?: string;
  lage?: "links" | "rechts" | "gerade";
  klebeband?: boolean;
  /** Erstes Foto der Seite sofort laden, alle anderen erst beim Scrollen. */
  sofort?: boolean;
  sizes?: string;
}

const { bild, alt, text, lage = "gerade", klebeband = false, sofort = false, sizes = "(min-width: 880px) 480px, 92vw" } = Astro.props;
---

<figure class:list={["foto", lage, { klebeband }]}>
  <Picture
    src={bild}
    alt={alt}
    formats={["avif", "webp"]}
    widths={[400, 640, 960, 1280]}
    sizes={sizes}
    loading={sofort ? "eager" : "lazy"}
    fetchpriority={sofort ? "high" : "auto"}
    decoding="async"
  />
  {text && <figcaption>{text}</figcaption>}
</figure>
